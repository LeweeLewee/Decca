# ── PlatformIO ───────────────────────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
*.elf
*.bin
*.map

# ── PlatformIO / editor metadata (kept local) ────────────────────────────────
.vscode/
!.vscode/extensions.json
.clangd/
compile_commands.json

# ── Build / test artefacts ───────────────────────────────────────────────────
build/
dist/
*.o
*.a

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets / local config (never commit) ────────────────────────────────────
secrets.h
*.local
.env

# ── Large / derived hardware & mechanical exports (commit deliberately) ──────
# Source files (schematics, CAD) ARE tracked. Uncomment to ignore bulky
# generated exports if they become a problem, and attach them to releases instead.
# *.gbr
# *.step
# *.stl
mechanical/CAD/__pycache__/

# A hand-exported 3MF of a superseded Rev Q build keeps getting swept in by
# `git add -A`. The generated, always-current one lives in mechanical/STL/ and
# is written by Decca_Display_Bezel_revQ_fusion.py export(). Remove this line if
# you ever want a CAD/-side 3MF tracked deliberately.
mechanical/CAD/Front_Bezel_revQ.3mf
